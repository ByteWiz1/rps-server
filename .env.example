# .env.example
#
# RPS Arena — server environment variables.
#
# Copy this file to .env for local development, and set the same values
# in Render → Environment for production. Never commit the real .env.
#
# Both Supabase values come from your Supabase project dashboard:
#   Project Settings → API → Project URL          → SUPABASE_URL
#   Project Settings → API → service_role secret  → SUPABASE_SERVICE_KEY
#
# The service_role key bypasses Row Level Security and must NEVER be
# shipped to the client (Vercel build, Expo bundle, anywhere). It lives
# only on the Render server.

# ──────────────────────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# service_role secret (starts with "eyJ..."). Server-only.
SUPABASE_SERVICE_KEY=

# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
# Render sets this automatically. Defaults to 3000 locally.
PORT=3000